<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_restagrup_cancel_reason_list" model="ir.ui.view">
        <field name="name">restagrup.cancel.reason.list</field>
        <field name="model">restagrup.cancel.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_restagrup_cancel_reason" model="ir.actions.act_window">
        <field name="name">Motivos de cancelación</field>
        <field name="res_model">restagrup.cancel.reason</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
