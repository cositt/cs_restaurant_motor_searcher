<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.restagrup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Restagrup" string="Restagrup" name="restagrup_core" groups="base.group_system">
                    <block title="Restagrup">
                        <setting id="restagrup_google_places"
                                 help="Usada por el buscador de restaurantes para traer candidatos nuevos por ciudad.">
                            <field name="restagrup_google_places_api_key" password="True"/>
                        </setting>
                        <setting id="restagrup_llm"
                                 help="Claves de los proveedores LLM usados para extraer datos de los emails de las agencias.">
                            <field name="restagrup_llm_providers_order"/>
                            <field name="restagrup_groq_api_key" password="True"/>
                            <field name="restagrup_gemini_api_key" password="True"/>
                        </setting>
                        <setting id="restagrup_quote_reminder"
                                 help="Texto del recordatorio automático a restaurantes que no responden a la petición de presupuesto.">
                            <field name="restagrup_quote_reminder_text" widget="text"
                                   placeholder="Vacío = texto por defecto"/>
                        </setting>
                        <setting id="restagrup_margin"
                                 help="Margen aplicado automáticamente al crear un presupuesto de venta a partir de un restaurante elegido.">
                            <field name="restagrup_default_margin_percent"/> %
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
