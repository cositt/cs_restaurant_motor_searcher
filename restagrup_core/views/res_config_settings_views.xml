<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.restagrup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Restagrup" string="Restagrup" name="restagrup_core" groups="base.group_system">
                    <block title="Restagrup">
                        <setting id="restagrup_google_places"
                                 help="Usada por el buscador de restaurantes para traer candidatos nuevos por ciudad.">
                            <field name="restagrup_google_places_api_key" password="True"/>
                        </setting>
                        <setting id="restagrup_llm"
                                 help="Claves de los proveedores LLM usados para extraer datos de los emails de las agencias.">
                            <field name="restagrup_llm_providers_order"/>
                            <field name="restagrup_groq_api_key" password="True"/>
                            <field name="restagrup_gemini_api_key" password="True"/>
                        </setting>
                        <setting id="restagrup_quote_reminder"
                                 help="Texto del recordatorio automático a restaurantes que no responden a la petición de presupuesto.">
                            <field name="restagrup_quote_reminder_text" widget="text"
                                   placeholder="Vacío = texto por defecto"/>
                        </setting>
                        <setting id="restagrup_agency_reminder"
                                 help="Recordatorio a agencias con presupuesto enviado y sin respuesta.">
                            <field name="restagrup_agency_reminder_days"/>
                            <field name="restagrup_agency_reminder_text" widget="text"
                                   placeholder="Vacío = texto por defecto"/>
                        </setting>
                        <setting id="restagrup_change_confirm"
                                 help="Reenviar cambios: qué cambio de comensales vuelve la hoja del restaurante a «pendiente de confirmar». Fecha y hora siempre piden confirmación.">
                            <field name="restagrup_change_confirm_pct"/>
                        </setting>
                        <setting id="restagrup_incoming"
                                 help="Buzón central: la IA clasifica cada correo antes de crear el lead. Y desde qué dirección salen los envíos del sistema.">
                            <field name="restagrup_classify_incoming"/>
                            <field name="restagrup_system_sender" placeholder="Vacío = correo del usuario"/>
                        </setting>
                        <setting id="restagrup_send_mode"
                                 help="Con aprobación: los correos que genera el sistema esperan en Restagrup > Pendientes de aprobar hasta que una persona los aprueba. Automático: salen solos.">
                            <field name="restagrup_send_mode"/>
                        </setting>
                        <setting id="restagrup_margin"
                                 help="Lo que Restagrup añade al precio del restaurante (20 % por defecto). El cliente paga el precio del restaurante más este porcentaje; la hoja de servicio del restaurante lleva su propio precio.">
                            <field name="restagrup_default_margin_percent"/> %
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
