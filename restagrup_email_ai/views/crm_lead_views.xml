<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_restagrup" model="ir.ui.view">
        <field name="name">crm.lead.form.restagrup</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[1]" position="before">
                <page name="restagrup_events" string="Servicios">
                    <div class="alert alert-info" role="alert"
                         invisible="restagrup_extraction_state != 'done' or not restagrup_event_ids">
                        Servicios propuestos por la IA a partir del email -- revísalos antes de buscar restaurantes.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="restagrup_extraction_state not in ('error', 'no_data')">
                        No se pudieron extraer datos automáticamente. Rellenar a mano.
                    </div>
                    <field name="restagrup_extraction_state" invisible="1"/>
                    <field name="restagrup_event_ids" nolabel="1">
                        <list editable="bottom">
                            <control>
                                <create string="Añadir un servicio"/>
                            </control>
                            <field name="sequence" widget="handle"/>
                            <field name="event_date"/>
                            <field name="event_time" widget="float_time"/>
                            <field name="event_time_is_default" column_invisible="1"/>
                            <field name="event_type_id" options="{'no_create': True}"/>
                            <field name="city"/>
                            <field name="pax"/>
                            <field name="audience" optional="hide"/>
                            <field name="budget_pp"/>
                            <field name="budget_is_estimate" widget="boolean_toggle" optional="show"/>
                            <field name="notes" optional="show"/>
                            <field name="state" widget="badge" decoration-info="state == 'draft'"
                                   decoration-success="state == 'searching'" readonly="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
