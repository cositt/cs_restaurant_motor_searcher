<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.restagrup.alerts</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="restagrup_core.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='restagrup_alerts']" position="after">
                <setting id="restagrup_alert_icons"
                         help="Iconos con contador en la esquina de la pantalla: pendientes de aprobar, peticiones nuevas, presupuestos por confirmar y elecciones del cliente.">
                    <field name="restagrup_alerts_notify_owner"/>
                    <div class="mt8">
                        <button name="%(restagrup_alerts.action_restagrup_alert_subscription)d" type="action"
                                string="Quién recibe cada aviso" icon="oi-arrow-right" class="btn-link"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
