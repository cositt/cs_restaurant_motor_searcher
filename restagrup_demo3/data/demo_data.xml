<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Interruptor de seguridad: el reinicio desde la guía solo funciona si vale 1 (BD de la demo 3). -->
        <record id="param_demo3_enabled" model="ir.config_parameter">
            <field name="key">restagrup_demo3.enabled</field>
            <field name="value">1</field>
        </record>
        <!-- En la demo se firma como la agencia desde la misma sesión (paso «La agencia firma»). -->
        <record id="param_demo3_staff_can_sign" model="ir.config_parameter">
            <field name="key">restagrup.portal_staff_can_sign</field>
            <field name="value">True</field>
        </record>
    </data>

    <record id="action_demo3_guide" model="ir.actions.client">
        <field name="name">Guía de la demo</field>
        <field name="tag">restagrup_demo3.guide</field>
    </record>

    <menuitem id="menu_demo3_guide" name="Guía" parent="restagrup_restaurants.menu_restagrup_root"
              action="action_demo3_guide" sequence="0"/>
</odoo>
