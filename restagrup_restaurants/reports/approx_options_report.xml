<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_approx_options_document">
        <t t-call="web.external_layout">
            <div class="page">
                <t t-set="lead" t-value="doc.request_lead_id"/>
                <t t-set="event" t-value="lead.restagrup_event_ids.filtered('city')[:1] or lead.restagrup_event_ids[:1]"/>
                <h2>Opciones orientativas</h2>
                <p class="text-muted">
                    <span t-out="lead.name"/>
                    <t t-if="event.city"> · <span t-out="event.city"/></t>
                    <t t-if="event.pax"> · <span t-out="event.pax"/> personas</t>
                </p>
                <div style="border: 2px solid #b8860b; color: #8a6508; padding: 8px 12px; margin: 10px 0 18px; font-weight: bold;">
                    Orientativo · Sujeto a disponibilidad y a los datos definitivos del grupo · Precios por persona, IVA incluido
                </div>
                <t t-foreach="doc.option_ids" t-as="option">
                    <table style="width: 100%; border: 1px solid #bbb; border-collapse: separate; margin-bottom: 18px; page-break-inside: avoid;">
                        <tr>
                            <td style="padding: 10px 14px; vertical-align: top;">
                                <div style="font-size: 17px; font-weight: bold;"
                                     t-out="option._title(option_index + 1, doc.option_show_restaurants)"/>
                                <div style="color: #666;" t-out="option.menu_name"/>
                            </td>
                            <td style="padding: 10px 14px; vertical-align: top; text-align: right; width: 32%; background: #f3f3f3;">
                                <div style="font-size: 22px; font-weight: bold;" t-out="option.price_per_person"
                                     t-options='{"widget": "monetary", "display_currency": option.currency_id}'/>
                                <div style="color: #666;">por persona</div>
                            </td>
                        </tr>
                        <tr t-if="option.menu_text">
                            <td colspan="2" style="padding: 8px 14px 12px; border-top: 1px solid #ddd;">
                                <div style="white-space: pre-line;" t-out="option.menu_text"/>
                            </td>
                        </tr>
                    </table>
                </t>
            </div>
        </t>
    </template>

    <template id="report_approx_options">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="restagrup_restaurants.report_approx_options_document"/>
            </t>
        </t>
    </template>

    <record id="action_report_approx_options" model="ir.actions.report">
        <field name="name">Opciones orientativas</field>
        <field name="model">restagrup.pending.mail</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">restagrup_restaurants.report_approx_options</field>
        <field name="report_file">restagrup_restaurants.report_approx_options</field>
        <field name="print_report_name">'Opciones orientativas - %s' % (object.request_lead_id.name or '')</field>
        <field name="binding_type">report</field>
    </record>
</odoo>
