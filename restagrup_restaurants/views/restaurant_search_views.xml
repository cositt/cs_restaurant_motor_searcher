<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_restaurant_search_form" model="ir.ui.view">
        <field name="name">restagrup.restaurant.search.form</field>
        <field name="model">restagrup.restaurant.search</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_lead" type="object" string="← Volver a la petición"
                            class="btn-secondary o_restagrup_back_btn" invisible="not lead_id"/>
                    <button name="action_search" type="object" string="Buscar restaurantes"
                            class="btn-primary" invisible="not city"/>
                    <button name="action_view_on_map" type="object" string="Ver en mapa"
                            class="btn-secondary" invisible="not line_ids"/>
                    <field name="interested_count" invisible="1"/>
                    <button name="action_request_quote_interested" type="object" class="btn-primary"
                            icon="fa-paper-plane" invisible="not interested_count"
                            string="Pedir presupuesto a interesados"
                            confirm="Se enviará la petición de presupuesto por correo a todos los restaurantes marcados como «Interesado» (también a los que tengan avisos de aforo o día de cierre). ¿Continuar?"/>
                    <field name="pipeline_stage" widget="statusbar"
                           statusbar_visible="searching,quotes_requested,quotes_received,chosen"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="lead_id" options="{'no_create': True}"/>
                            <field name="event_id" readonly="1" invisible="not event_id" options="{'no_open': True}"/>
                            <field name="city"/>
                            <field name="min_capacity"/>
                            <field name="budget_pp" invisible="not budget_pp"/>
                            <field name="restaurant_visible"/>
                        </group>
                        <group>
                            <field name="restaurant_name" placeholder="Opcional: parte del nombre"/>
                            <field name="chosen_line_id" readonly="1" invisible="not chosen_line_id"
                                   options="{'no_open': True}" widget="badge"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                    </group>
                    <details class="o_restagrup_filters mb-3">
                        <summary>Filtros: calle, código postal, parking de bus, cocina, precio y tipo de local</summary>
                        <group>
                            <group>
                                <field name="street"/>
                                <field name="zip"/>
                                <field name="require_bus_parking"/>
                            </group>
                            <group>
                                <field name="cuisine_type"/>
                                <field name="max_price_level"/>
                            </group>
                        </group>
                        <group string="Tipo de local a buscar">
                            <field name="search_type_restaurant"/>
                            <field name="search_type_bar"/>
                            <field name="search_type_cafe"/>
                            <field name="search_type_fastfood"/>
                        </group>
                    </details>
                    <group string="Notas de la búsqueda">
                        <field name="notes" nolabel="1"/>
                    </group>
                    <notebook>
                        <page name="results" string="Resultados">
                            <div class="d-flex align-items-center mb-2" style="gap:8px" invisible="not line_ids">
                                <label for="sort_by" string="Ordenar por" class="mb-0"/>
                                <field name="sort_by" nolabel="1" style="max-width:220px"/>
                                <button name="action_apply_sort" type="object" string="Aplicar" class="btn-secondary btn-sm"/>
                            </div>
                            <field name="line_ids">
                                <kanban class="o_restagrup_rest_kanban" create="false">
                                    <field name="name"/>
                                    <field name="source"/>
                                    <field name="address"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                    <field name="rating"/>
                                    <field name="review_count"/>
                                    <field name="partner_id"/>
                                    <field name="cuisine_type"/>
                                    <field name="price_label"/>
                                    <field name="capacity"/>
                                    <field name="bus_parking"/>
                                    <field name="suitable_corporate"/>
                                    <field name="suitable_school"/>
                                    <field name="suitable_family"/>
                                    <field name="internal_notes"/>
                                    <field name="etiqueta"/>
                                    <field name="quote_received_date"/>
                                    <field name="quote_amount"/>
                                    <field name="quote_price_pp"/>
                                    <field name="quote_client_price_per_person"/>
                                    <field name="quote_days_pending"/>
                                    <field name="quote_is_stale"/>
                                    <field name="quote_availability_pending"/>
                                    <field name="partner_menu_count"/>
                                    <field name="partner_restaurant_rating"/>
                                    <field name="is_chosen"/>
                                    <field name="partner_incomplete"/>
                                    <field name="missing_fields_text"/>
                                    <field name="warnings_text"/>
                                    <field name="data_proposal"/>
                                    <field name="data_proposal_summary"/>
                                    <field name="quote_pending_confirmation"/>
                                    <field name="google_maps_url"/>
                                    <field name="price_warning"/>
                                    <field name="known_price_pp"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="o_restagrup_rest_card_header">
                                                <h4>
                                                    <t t-esc="record.name.value"/>
                                                    <span t-if="record.is_chosen.raw_value" class="o_restagrup_chosen_star" title="Elegido"> ★</span>
                                                </h4>
                                                <span t-attf-class="o_restagrup_rest_source_badge source_{{record.source.raw_value}}">
                                                    <t t-if="record.source.raw_value == 'partner'">En Odoo</t>
                                                    <t t-else="">Google</t>
                                                </span>
                                            </div>
                                                <div class="o_restagrup_rating_row" t-if="record.partner_id.raw_value">
                                                    <span t-if="record.partner_restaurant_rating.raw_value"
                                                          t-attf-class="badge-rating rating-{{record.partner_restaurant_rating.raw_value}}">
                                                        <t t-esc="record.partner_restaurant_rating.value"/>
                                                    </span>
                                                    <button name="action_rate_liked" type="object" class="btn btn-link btn-sm" title="Nos gustó">👍</button>
                                                    <button name="action_rate_neutral" type="object" class="btn btn-link btn-sm" title="Neutral">➖</button>
                                                    <button name="action_rate_disliked" type="object" class="btn btn-link btn-sm" title="No repetir">👎</button>
                                                </div>
                                                <div class="o_restagrup_rest_dir" t-if="record.address.raw_value">
                                                    📍 <t t-esc="record.address.value"/>
                                                </div>
                                                <div class="o_restagrup_rest_tags">
                                                    <span class="tag" t-if="record.rating.raw_value">★ <t t-esc="record.rating.raw_value"/> (<t t-esc="record.review_count.raw_value"/>)</span>
                                                    <span class="tag" t-if="record.cuisine_type.raw_value"><t t-esc="record.cuisine_type.value"/></span>
                                                    <span class="tag" t-if="record.price_label.raw_value"><t t-esc="record.price_label.value"/></span>
                                                    <span class="tag" t-if="record.capacity.raw_value">Hasta <t t-esc="record.capacity.raw_value"/> pax</span>
                                                    <span class="tag" t-if="record.bus_parking.raw_value">🚌 Parking bus</span>
                                                    <span class="tag" t-if="record.suitable_corporate.raw_value">Corporativo</span>
                                                    <span class="tag" t-if="record.suitable_school.raw_value">Escolar</span>
                                                    <span class="tag" t-if="record.suitable_family.raw_value">Familiar</span>
                                                </div>
                                                <div class="o_restagrup_rest_warning" t-if="record.price_warning.raw_value">
                                                    💶 <t t-esc="record.price_warning.value"/>
                                                </div>
                                                <div class="o_restagrup_rest_warning" t-if="record.warnings_text.raw_value">
                                                    ⚠ <t t-esc="record.warnings_text.value"/>
                                                </div>
                                                <div class="o_restagrup_rest_incomplete" t-if="record.partner_incomplete.raw_value">
                                                    <span class="tag">Ficha incompleta</span>
                                                    <span class="text-muted small">Faltan: <t t-esc="record.missing_fields_text.value"/></span>
                                                    <button name="action_request_missing_data" type="object"
                                                            class="btn btn-link btn-sm">Pedir datos que faltan</button>
                                                </div>
                                                <div class="o_restagrup_rest_proposal" t-if="record.data_proposal.raw_value">
                                                    🤖 Datos propuestos por IA, sin confirmar: <t t-esc="record.data_proposal_summary.value"/>
                                                    <button name="action_apply_data_proposal" type="object"
                                                            class="btn btn-primary btn-sm">Aplicar</button>
                                                    <button name="action_discard_data_proposal" type="object"
                                                            class="btn btn-link btn-sm">Descartar</button>
                                                </div>
                                                <div class="o_restagrup_rest_notes" t-if="record.internal_notes.raw_value">
                                                    📝 <t t-esc="record.internal_notes.value"/>
                                                </div>
                                                <div class="o_restagrup_rest_actions">
                                                    <a t-if="record.google_maps_url.raw_value" t-att-href="record.google_maps_url.raw_value"
                                                       target="_blank" role="button" class="btn btn-outline-secondary btn-sm">Maps</a>
                                                    <a t-if="record.phone.raw_value" t-attf-href="tel:{{record.phone.raw_value}}"
                                                       role="button" class="btn btn-outline-secondary btn-sm"><t t-esc="record.phone.value"/></a>
                                                    <a t-if="record.email.raw_value" t-attf-href="mailto:{{record.email.raw_value}}"
                                                       role="button" class="btn btn-outline-secondary btn-sm">Email</a>
                                                    <button t-if="!record.partner_id.raw_value" name="action_add_as_partner" type="object"
                                                            class="btn btn-link btn-sm">Añadir como contacto</button>
                                                    <button t-if="record.partner_id.raw_value" name="action_view_menus" type="object"
                                                            class="btn btn-outline-secondary btn-sm" title="Menús del restaurante: coste, venta y pedir uno concreto">👁 Ver menús</button>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center flex-wrap" style="gap:6px">
                                                    <t t-set="step_order" t-value="['interesado', 'solicitado', 'presupuesto_recibido']"/>
                                                    <t t-set="step_now" t-value="record.is_chosen.raw_value ? 3 : step_order.indexOf(record.etiqueta.raw_value)"/>
                                                    <span t-if="step_now &gt;= 0" class="o_restagrup_steps" title="Etapas del restaurante en esta búsqueda">
                                                        <t t-foreach="['Interesado', 'Pedido', 'Recibido', 'Elegido']" t-as="step_label" t-key="step_label_index">
                                                            <span t-attf-class="o_restagrup_step {{step_label_index &lt;= step_now ? 'done' : ''}} {{step_label_index == step_now ? 'current' : ''}}"
                                                                  t-esc="step_label"/>
                                                        </t>
                                                    </span>
                                                    <span t-else="" t-attf-class="badge-etiqueta etiqueta-{{record.etiqueta.raw_value}}">
                                                        <t t-esc="record.etiqueta.value"/>
                                                    </span>
                                                    <span class="o_restagrup_quote_amount"
                                                          t-if="record.quote_price_pp.raw_value and !record.quote_pending_confirmation.raw_value"
                                                          title="Precio por persona a la agencia, con nuestra comisión. Debajo, lo que cobra el restaurante.">
                                                        💶 <t t-esc="record.quote_client_price_per_person.value"/> €/pers.
                                                        <small class="o_restagrup_quote_cost d-block text-muted">coste <t t-esc="record.quote_price_pp.value"/> €/pers.</small>
                                                    </span>
                                                    <span class="o_restagrup_quote_pending" t-if="record.quote_pending_confirmation.raw_value"
                                                          title="La IA propuso este precio a partir de la respuesta del restaurante. Confírmalo para poder elegirlo.">
                                                        💶 <t t-esc="record.quote_client_price_per_person.value"/> €/pers. · propuesto por IA, sin confirmar
                                                        <small class="o_restagrup_quote_cost d-block text-muted">coste <t t-esc="record.quote_price_pp.value"/> €/pers.</small>
                                                    </span>
                                                    <span class="badge text-bg-warning" t-if="record.quote_availability_pending.raw_value"
                                                          title="Presupuesto con el precio del catálogo: el restaurante aún no ha confirmado que tenga sitio">Disponibilidad sin confirmar</span>
                                                    <span class="o_restagrup_stale_badge" t-if="record.quote_is_stale.raw_value">
                                                        ⚠ <t t-esc="record.quote_days_pending.raw_value"/> días sin respuesta
                                                    </span>
                                                    <div class="o_restagrup_etiqueta_btn_row">
                                                        <button t-if="!['solicitado', 'presupuesto_recibido'].includes(record.etiqueta.raw_value)"
                                                                name="action_mark_interesado" type="object" class="btn btn-outline-secondary">Interesado</button>
                                                        <button t-if="record.etiqueta.raw_value != 'descartado'"
                                                                name="action_mark_descartado" type="object" class="btn btn-outline-secondary">Descartar</button>
                                                        <button t-if="record.etiqueta.raw_value == 'descartado' and record.quote_received_date.raw_value and record.quote_price_pp.raw_value"
                                                                name="action_recover_quote" type="object" class="btn btn-outline-primary"
                                                                title="Vuelve con el presupuesto que ya dio, sin pedirlo otra vez">Recuperar</button>
                                                        <button t-if="record.etiqueta.raw_value != 'presupuesto_recibido' and record.etiqueta.raw_value != 'solicitado' and !record.warnings_text.raw_value"
                                                                name="action_request_quote" type="object" class="btn btn-outline-primary">Pedir presupuesto</button>
                                                        <button t-if="record.etiqueta.raw_value != 'presupuesto_recibido' and record.etiqueta.raw_value != 'solicitado' and record.warnings_text.raw_value"
                                                                name="action_request_quote" type="object" class="btn btn-outline-primary"
                                                                confirm="Este restaurante tiene avisos para la petición (aforo o día de cierre). ¿Pedir presupuesto igualmente?">Pedir presupuesto</button>
                                                        <button t-if="record.etiqueta.raw_value == 'solicitado'"
                                                                name="action_request_quote" type="object" class="btn btn-outline-primary">Reenviar petición</button>
                                                        <button t-if="record.quote_pending_confirmation.raw_value"
                                                                name="action_register_quote" type="object" class="btn btn-primary">Confirmar presupuesto</button>
                                                        <button t-if="record.etiqueta.raw_value != 'presupuesto_recibido'"
                                                                name="action_open_quote_form" type="object" class="btn btn-outline-primary"
                                                                title="Por correo, WhatsApp o teléfono: pega su respuesta o escribe el precio">Registrar presupuesto</button>
                                                        <button t-if="record.etiqueta.raw_value != 'presupuesto_recibido' and record.partner_menu_count.raw_value"
                                                                name="action_quote_from_catalog" type="object" class="btn btn-outline-primary"
                                                                title="Presupuesto con el menú de su ficha, sin esperar a que conteste (disponibilidad sin confirmar)">Precio de catálogo</button>
                                                        <button t-if="record.quote_availability_pending.raw_value"
                                                                name="action_confirm_availability" type="object" class="btn btn-outline-success">Disponibilidad OK</button>
                                                        <button t-if="record.etiqueta.raw_value == 'solicitado' or record.etiqueta.raw_value == 'presupuesto_recibido'"
                                                                name="action_view_conversation" type="object" class="btn btn-outline-secondary">Ver conversación</button>
                                                        <button name="action_toggle_chosen" type="object" class="btn btn-outline-success">
                                                            <t t-if="record.is_chosen.raw_value">Quitar elegido</t>
                                                            <t t-else="">Elegir</t>
                                                        </button>
                                                    </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page name="quotes" string="Presupuestos">
                            <field name="quoted_line_ids" nolabel="1" readonly="1">
                                <list create="false" delete="false" edit="false"
                                      decoration-success="is_chosen" decoration-warning="quote_pending_confirmation">
                                    <field name="is_chosen" column_invisible="True"/>
                                    <field name="quote_pending_confirmation" column_invisible="True"/>
                                    <field name="name" string="Restaurante"/>
                                    <field name="etiqueta" string="Estado" widget="badge"/>
                                    <field name="quote_client_price_per_person" string="Agencia (€/pers.)"/>
                                    <field name="quote_price_pp" string="Restaurante (€/pers.)"/>
                                    <field name="quote_amount" string="Total grupo (€)" optional="hide"/>
                                    <field name="menu_id" string="Menú"/>
                                    <field name="quote_received_date" string="Recibido"/>
                                    <field name="quote_notes"/>
                                    <button name="action_register_quote" type="object" string="Confirmar"
                                            class="btn-primary" invisible="not quote_pending_confirmation"/>
                                    <button name="action_toggle_chosen" type="object" string="Elegir"
                                            class="btn-outline-success" invisible="is_chosen"/>
                                    <button name="action_toggle_chosen" type="object" string="Quitar elegido"
                                            class="btn-outline-secondary" invisible="not is_chosen"/>
                                    <button name="action_view_conversation" type="object" string="Ver conversación"
                                            class="btn-link"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_restaurant_search_line_quote_form" model="ir.ui.view">
        <field name="name">restagrup.restaurant.search.line.quote.form</field>
        <field name="model">restagrup.restaurant.search.line</field>
        <field name="arch" type="xml">
            <form string="Registrar presupuesto">
                <group>
                    <field name="name" readonly="1"/>
                </group>
                <div class="alert alert-info" role="status" invisible="context.get('restagrup_from_catalog')">
                    ¿Te lo dio por WhatsApp o por teléfono? Escribe directamente el precio por persona en el paso 2.
                </div>
                <div class="alert alert-warning" role="status" invisible="not context.get('restagrup_from_catalog')">
                    Elige el menú de su ficha: su precio será el presupuesto (disponibilidad sin confirmar).
                </div>
                <group string="1. Pega la respuesta del restaurante" invisible="context.get('restagrup_from_catalog')">
                    <field name="quote_raw_text" nolabel="1" colspan="2"
                           placeholder="Pega aquí el correo o el menú tal cual lo manda el restaurante (con el precio por persona)..."/>
                    <button name="action_extract_quote_from_text" type="object" icon="fa-magic"
                            string="Leer con IA: precio y menú" class="btn-primary"/>
                </group>
                <group string="2. Revisa y registra (lo rellena la IA; puedes corregirlo)">
                    <field name="quote_price_pp" string="Precio por persona del restaurante (€)"/>
                    <field name="quote_client_price_per_person" string="Precio a la agencia por persona (€)"/>
                    <field name="quote_amount" string="Total del grupo (€)" readonly="1"/>
                    <field name="partner_id" invisible="1"/>
                    <field name="menu_id" invisible="not partner_id" options="{'no_create': True}"/>
                    <field name="quote_notes"/>
                </group>
                <footer>
                    <button name="action_register_quote" type="object" string="Registrar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_restaurant_search_list" model="ir.ui.view">
        <field name="name">restagrup.restaurant.search.list</field>
        <field name="model">restagrup.restaurant.search</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Fecha"/>
                <field name="lead_id"/>
                <field name="city"/>
                <field name="min_capacity"/>
                <field name="line_count" string="Resultados"/>
                <field name="chosen_line_id" string="Elegido"/>
                <field name="pipeline_stage" string="Estado" widget="badge"
                       decoration-info="pipeline_stage == 'searching'"
                       decoration-warning="pipeline_stage == 'quotes_requested'"
                       decoration-primary="pipeline_stage == 'quotes_received'"
                       decoration-success="pipeline_stage == 'chosen'"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="action_restaurant_search" model="ir.actions.act_window">
        <field name="name">Búsquedas de restaurantes</field>
        <field name="res_model">restagrup.restaurant.search</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_restaurant_search" name="Buscar restaurantes" parent="menu_restagrup_root"
              action="action_restaurant_search" sequence="20"/>
    <menuitem id="menu_restagrup_cancel_reasons" name="Motivos de cancelación" parent="menu_restagrup_root"
              action="restagrup_core.action_restagrup_cancel_reason" sequence="91"/>
    <menuitem id="menu_restagrup_event_types" name="Tipos de servicio" parent="menu_restagrup_root"
              action="restagrup_core.action_restagrup_event_type" sequence="90"/>
    <menuitem id="menu_restagrup_price_baselines" name="Baremos de precio estimado" parent="menu_restagrup_root"
              action="restagrup_core.action_restagrup_price_baseline" sequence="92"/>
</odoo>
