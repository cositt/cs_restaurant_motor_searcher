<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_menu_duplicate_wizard_form" model="ir.ui.view">
        <field name="name">restagrup.menu.duplicate.wizard.form</field>
        <field name="model">restagrup.menu.duplicate.wizard</field>
        <field name="arch" type="xml">
            <form string="Ya hay un menú parecido">
                <div class="alert alert-warning" role="status">
                    Antes de guardar el menú de la respuesta: en la ficha del restaurante ya hay uno igual o casi igual.
                    El precio leído por la IA ya está propuesto en el presupuesto.
                </div>
                <field name="line_id" invisible="1"/>
                <field name="payload" invisible="1"/>
                <field name="can_create_new" invisible="1"/>
                <field name="summary" nolabel="1" readonly="1"/>
                <footer>
                    <button name="action_use_existing" type="object" string="Usar el que ya hay"
                            class="btn-primary"/>
                    <button name="action_create_new" type="object" string="Crear uno nuevo igualmente"
                            class="btn-secondary" invisible="not can_create_new"/>
                    <button name="action_cancel" type="object" string="No guardar el menú" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
