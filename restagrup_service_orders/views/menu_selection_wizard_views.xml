<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_menu_selection_wizard_form" model="ir.ui.view">
        <field name="name">restagrup.menu.selection.wizard.form</field>
        <field name="model">restagrup.menu.selection.wizard</field>
        <field name="arch" type="xml">
            <form string="Elegir menús">
                <p class="text-muted">
                    Marca los menús de <field name="restaurant_id" readonly="1" class="oe_inline"/>
                    que irán al presupuesto de venta, con la cantidad de cada uno. Cada menú será
                    una línea con su precio de venta.
                </p>
                <field name="search_id" invisible="1"/>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="selected"/>
                        <field name="product_tmpl_id" readonly="1"/>
                        <field name="quantity"/>
                        <field name="list_price" readonly="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Crear presupuesto de venta"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
