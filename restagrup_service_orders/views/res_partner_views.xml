<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_restaurant_worked_with" model="ir.ui.view">
        <field name="name">res.partner.form.restaurant.worked.with</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="restagrup_restaurants.view_partner_form_restaurant"/>
        <field name="arch" type="xml">
            <field name="restaurant_internal_rating" position="before">
                <field name="restaurant_worked_with"/>
            </field>
            <xpath expr="//notebook" position="inside">
                <page string="Menús de producto (avanzado)" name="restaurant_menus" invisible="not is_restaurant"
                      groups="base.group_system">
                    <field name="menu_ids" context="{'default_restaurant_id': id, 'default_type': 'service', 'default_sale_ok': True, 'default_purchase_ok': False}">
                        <list>
                            <field name="name"/>
                            <field name="standard_price" string="Precio del restaurante (€)"/>
                            <field name="restagrup_client_price" string="Precio al cliente (€)"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Razón social: el nombre fiscal de la agencia para las facturas (PPT de Conchita, diapositiva 2). -->
    <record id="view_partner_form_legal_name" model="ir.ui.view">
        <field name="name">res.partner.form.restagrup.legal.name</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="vat" position="before">
                <field name="restagrup_legal_name" invisible="not is_company"/>
            </field>
        </field>
    </record>

    <!-- Ficha de agencia como la de su CRM: arriba los datos de facturación; debajo, los datos adicionales. -->
    <record id="view_partner_form_agency_data" model="ir.ui.view">
        <field name="name">res.partner.form.restagrup.agency.data</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']/../.." position="after">
                <group name="agency_data" string="Datos adicionales de la agencia" col="4"
                       invisible="not is_company or is_restaurant">
                    <field name="agency_trade_name"/>
                    <field name="ref" string="Código"/>
                    <field name="agency_payment_mode" widget="radio" options="{'horizontal': true}"/>
                    <field name="restagrup_origin_id" options="{'no_create_edit': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
