<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_restaurant_worked_with" model="ir.ui.view">
        <field name="name">res.partner.form.restaurant.worked.with</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="restagrup_restaurants.view_partner_form_restaurant"/>
        <field name="arch" type="xml">
            <field name="restaurant_internal_rating" position="before">
                <field name="restaurant_worked_with"/>
            </field>
            <xpath expr="//notebook" position="inside">
                <page string="Menús" name="restaurant_menus" invisible="not is_restaurant">
                    <field name="menu_ids" context="{'default_restaurant_id': id, 'default_type': 'service', 'default_sale_ok': True, 'default_purchase_ok': False}">
                        <list>
                            <field name="name"/>
                            <field name="standard_price" string="Precio del restaurante (€)"/>
                            <field name="restagrup_client_price" string="Precio al cliente (€)"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
