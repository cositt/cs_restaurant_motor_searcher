<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ficha de agencia sencilla, como la de su CRM (ronda de ajustes 09/11): datos de facturación, datos
         adicionales (con el origen) y sus contactos. Solo la abre el menú Agencias; el resto de Odoo sigue igual. -->
    <record id="view_partner_agency_form" model="ir.ui.view">
        <field name="name">res.partner.form.restagrup.agency.simple</field>
        <field name="model">res.partner</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Agencia">
                <sheet>
                    <field name="is_company" invisible="1"/>
                    <field name="company_type" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre de la agencia" required="1"/></h1>
                    </div>
                    <notebook>
                        <page name="details" string="Detalles">
                            <group>
                                <group string="Datos de facturación">
                                    <field name="restagrup_legal_name"/>
                                    <field name="vat" string="CIF"/>
                                    <field name="street" string="Dirección fiscal"/>
                                    <field name="zip" string="C.P."/>
                                    <field name="city" string="Localidad"/>
                                    <field name="state_id" string="Provincia" options="{'no_create': True}"/>
                                    <field name="country_id" string="País" options="{'no_create': True}"/>
                                    <field name="phone" string="Teléfono"/>
                                    <field name="email"/>
                                </group>
                                <group string="Datos adicionales">
                                    <field name="agency_trade_name"/>
                                    <field name="website" string="Web" widget="url"/>
                                    <field name="ref" string="Código"/>
                                    <field name="restagrup_origin_id" options="{'no_create_edit': True}"/>
                                    <field name="agency_payment_mode" widget="radio" options="{'horizontal': true}"
                                           string="Métodos de pago"/>
                                </group>
                            </group>
                        </page>
                        <page name="contacts" string="Contactos">
                            <field name="child_ids" context="{'default_parent_id': id, 'default_type': 'contact'}">
                                <list editable="bottom">
                                    <control>
                                        <create string="Añadir un contacto"/>
                                    </control>
                                    <field name="type" column_invisible="1"/>
                                    <field name="name" required="1"/>
                                    <field name="function" string="Cargo"/>
                                    <field name="phone" string="Teléfono"/>
                                    <field name="email"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_agency_origin_list" model="ir.ui.view">
        <field name="name">restagrup.agency.origin.list</field>
        <field name="model">restagrup.agency.origin</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_agency_origin" model="ir.actions.act_window">
        <field name="name">Origen de las agencias</field>
        <field name="res_model">restagrup.agency.origin</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_restagrup_agency_origins" name="Origen de las agencias"
              parent="restagrup_restaurants.menu_restagrup_root" action="action_agency_origin" sequence="93"
              groups="sales_team.group_sale_manager"/>
</odoo>
