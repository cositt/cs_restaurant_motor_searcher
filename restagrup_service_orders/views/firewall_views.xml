<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_firewall_wizard_form" model="ir.ui.view">
        <field name="name">restagrup.firewall.wizard.form</field>
        <field name="model">restagrup.firewall.wizard</field>
        <field name="arch" type="xml">
            <form string="Antes de continuar">
                <div class="alert alert-warning" role="alert">
                    Esto es lo que falta o no cuadra. Puedes continuar de todos modos: quedará anotado en el chatter.
                </div>
                <field name="message" nolabel="1" widget="text"/>
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="method" invisible="1"/>
                <footer>
                    <button name="action_cancel" type="object" string="Volver a revisar" class="btn-primary"/>
                    <button name="action_continue" type="object" string="Continuar de todos modos" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_firewall_check_list" model="ir.ui.view">
        <field name="name">restagrup.firewall.check.list</field>
        <field name="model">restagrup.firewall.check</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false" delete="false">
                <field name="trigger"/>
                <field name="name"/>
                <field name="mode"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_firewall_checks" model="ir.actions.act_window">
        <field name="name">Cortafuegos</field>
        <field name="res_model">restagrup.firewall.check</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem id="menu_firewall_checks" name="Cortafuegos" parent="restagrup_restaurants.menu_restagrup_root"
              action="action_firewall_checks" sequence="95" groups="base.group_system"/>
</odoo>
