<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_group_not_going" model="ir.ui.view">
        <field name="name">sale.order.form.group.not.going</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_group_not_going" type="object" string="Grupo no sale"
                        invisible="state not in ('draft', 'sent')"
                        confirm="Se cancelará el presupuesto, el grupo pasará a perdido y se dejará en «Pendientes de aprobar» un aviso de cancelación para cada restaurante con petición abierta. ¿Continuar?"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="restagrup_service_date"/>
                <field name="restagrup_agency_reminder_date" invisible="not restagrup_agency_reminder_date"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_unanswered_list" model="ir.ui.view">
        <field name="name">sale.order.list.unanswered</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Presupuestos sin respuesta" default_order="restagrup_service_date asc, id">
                <field name="name"/>
                <field name="partner_id" string="Agencia / cliente"/>
                <field name="restagrup_service_date"/>
                <field name="restagrup_days_to_service" string="Días que faltan" invisible="not restagrup_service_date"/>
                <field name="restagrup_last_contact"/>
                <field name="restagrup_agency_reminder_date" string="Recordado"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_sale_orders_unanswered" model="ir.actions.act_window">
        <field name="name">Presupuestos sin respuesta</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'sent')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_order_unanswered_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('sale.view_order_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ningún presupuesto enviado a la espera de respuesta</p>
        </field>
    </record>

    <menuitem id="menu_sale_orders_unanswered" name="Presupuestos sin respuesta"
              parent="restagrup_restaurants.menu_restagrup_root" action="action_sale_orders_unanswered"
              sequence="25"/>
</odoo>
