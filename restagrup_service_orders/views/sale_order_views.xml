<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_restaurant" model="ir.ui.view">
        <field name="name">sale.order.form.restaurant</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/form" position="inside">
                <group string="Restagrup">
                    <field name="restaurant_id"/>
                    <field name="service_date"/>
                    <field name="service_hour" widget="float_time"/>
                    <field name="service_event_type_id"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="restaurant_id" optional="show"/>
                <field name="service_date" optional="show"/>
                <field name="service_hour" widget="float_time" optional="show"/>
                <field name="service_event_type_id" optional="show"/>
            </xpath>
            <!-- Margen de Restagrup: solo en la vista interna. El cliente nunca ve estas columnas. -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="restagrup_unit_cost" optional="show"/>
                <field name="restagrup_margin_pct" optional="show"/>
                <field name="restagrup_margin_amount" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="restagrup_show_margin" widget="boolean_toggle"/>
            </xpath>
            <xpath expr="//group[@name='sale_total']" position="inside">
                <field name="restagrup_cost_total" invisible="not restagrup_margin_total"/>
                <field name="restagrup_margin_total" invisible="not restagrup_margin_total"/>
                <field name="restagrup_margin_percent" invisible="not restagrup_margin_total"/>
            </xpath>
            <xpath expr="//header" position="after">
                <div class="alert alert-info mb-0" role="alert" invisible="not restagrup_is_additional">
                    <field name="restagrup_is_additional" invisible="1"/>
                    Presupuesto adicional del grupo: el primero es
                    <field name="restagrup_first_order_id" readonly="1" nolabel="1" class="oe_inline"/>.
                </div>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_restaurant_pos" type="object"
                        class="oe_stat_button" icon="fa-cutlery"
                        invisible="not restaurant_po_count">
                    <field name="restaurant_po_count" widget="statinfo" string="Hojas de servicio"/>
                </button>
                <button name="action_view_restaurant_pos" type="object"
                        class="oe_stat_button" icon="fa-check-circle"
                        invisible="not restagrup_confirmation_summary">
                    <field name="restagrup_confirmation_summary" widget="statinfo"
                           string="Restaurantes confirmados"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_send_restaurant_orders" type="object"
                        string="Enviar hojas de servicio" class="btn-secondary"
                        invisible="state != 'sale' or not restaurant_po_count"/>
                <button name="action_resend_restaurant_orders" type="object"
                        string="Reenviar cambios" class="btn-warning"
                        invisible="not restaurant_changes_pending"/>
            </xpath>
        </field>
    </record>
</odoo>
