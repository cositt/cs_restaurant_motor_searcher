<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Interruptor de seguridad: el reinicio desde la guía solo funciona si vale 1 (BD de demo). -->
        <record id="param_demo_enabled" model="ir.config_parameter">
            <field name="key">restagrup_demo.enabled</field>
            <field name="value">1</field>
        </record>
    </data>

    <record id="action_demo_guide" model="ir.actions.client">
        <field name="name">Guía de la demo</field>
        <field name="tag">restagrup_demo.guide</field>
    </record>

    <menuitem id="menu_demo_guide" name="Guía" parent="restagrup_restaurants.menu_restagrup_root"
              action="action_demo_guide" sequence="0"/>
</odoo>
