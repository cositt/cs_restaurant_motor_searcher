<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="restagrup_demo.Guide">
        <div class="o_rg_guide">
            <div class="o_rg_guide_head">
                <img class="o_rg_guide_logo" src="/restagrup_demo/static/description/icon.png" alt="Restagrup"/>
                <div class="o_rg_guide_titles">
                    <h1>Recorrido de la demo</h1>
                    <p>De la petición de una agencia a la hoja de servicio del restaurante, en 9 pasos.</p>
                </div>
                <button class="o_rg_btn_ghost" t-on-click="toggleNotes">
                    <t t-if="state.notes">Ocultar notas del presentador</t>
                    <t t-else="">Notas del presentador</t>
                </button>
            </div>

            <div class="o_rg_steps">
                <t t-foreach="steps" t-as="step" t-key="step.key">
                    <t t-set="btn" t-value="buttonFor(step)"/>
                    <div t-attf-class="o_rg_step {{ stepClass(step_index) }}">
                        <div class="o_rg_step_num">
                            <t t-if="state.data.done[step.key]"><i class="fa fa-check"/></t>
                            <t t-else=""><t t-esc="step_index + 1"/></t>
                        </div>
                        <div class="o_rg_step_body">
                            <div class="o_rg_step_title" t-esc="step.title"/>
                            <div class="o_rg_step_todo" t-esc="step.todo"/>
                            <div t-if="state.notes" class="o_rg_step_say">
                                <i class="fa fa-comment-o"/> <t t-esc="step.say"/>
                            </div>
                        </div>
                        <button t-attf-class="o_rg_btn #{ btn.call ? 'o_rg_btn_primary' : 'o_rg_btn_secondary' }"
                                t-att-disabled="btn.disabled or state.busy ? 'disabled' : null"
                                t-on-click="() => this.onButton(btn)">
                            <t t-esc="btn.label"/>
                        </button>
                    </div>
                </t>
            </div>

            <div class="o_rg_guide_foot">
                <span t-if="currentIndex === steps.length" class="o_rg_done_msg">
                    <i class="fa fa-check-circle"/> Recorrido completo.
                </span>
                <button class="o_rg_btn_ghost o_rg_reset" t-on-click="askReset">Reiniciar la demo</button>
            </div>
        </div>
    </t>
</templates>
