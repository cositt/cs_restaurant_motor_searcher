<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Propuesta conjunta desde la petición (PPT de Conchita 2026-11-04, urgente 4). -->
    <record id="view_lead_proposal_wizard_form" model="ir.ui.view">
        <field name="name">restagrup.lead.proposal.wizard.form</field>
        <field name="model">restagrup.lead.proposal.wizard</field>
        <field name="arch" type="xml">
            <form string="Enviar propuesta a la agencia">
                <div class="alert alert-warning" role="alert" invisible="not chosen_warning">
                    <field name="chosen_warning" readonly="1" nolabel="1"/>
                </div>
                <group>
                    <field name="lead_id" invisible="1"/>
                    <field name="email_to"/>
                    <field name="subject"/>
                    <field name="include_portal_link"/>
                    <field name="show_restaurants"/>
                    <field name="let_agency_choose" invisible="not chosen_warning or not include_portal_link"/>
                </group>
                <field name="body" nolabel="1"/>
                <p class="text-muted small">
                    Va un PDF con todos los servicios y, si se marca, un enlace donde la agencia elige un restaurante
                    por servicio. Antes de enviar verás un resumen para revisarlo.
                </p>
                <footer>
                    <button name="action_send" type="object" string="Enviar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="crm_lead_view_form_proposal" model="ir.ui.view">
        <field name="name">crm.lead.form.restagrup.proposal</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="restagrup_proposal_ready" invisible="1"/>
                <field name="restagrup_quote_ready" invisible="1"/>
                <button name="action_open_proposal_wizard" type="object" string="Enviar propuesta a la agencia"
                        class="btn-primary"
                        invisible="not restagrup_proposal_ready or restagrup_stage_key in ('expediente', 'cerrado')"/>
                <button name="action_create_joint_quote" type="object" string="Crear presupuesto"
                        class="btn-primary"
                        invisible="not restagrup_quote_ready or restagrup_stage_key in ('expediente', 'cerrado')"/>
            </xpath>
            <!-- En el expediente un servicio nuevo se añade con «Añadir servicio», no con un presupuesto suelto -->
            <!-- Fuera «Nuevo presupuesto» en todas las fases (ronda de ajustes 09/11): el presupuesto sale de
                 «Crear presupuesto» con lo elegido, o al pasar a expediente. -->
            <xpath expr="//header/button[@name='action_sale_quotations_new']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='restagrup_events']" position="after">
                <page name="restagrup_proposal" string="Propuesta" invisible="not restagrup_proposal_ready">
                    <div class="alert alert-success mb-2" role="status"
                         invisible="restagrup_stage_key not in ('expediente', 'cerrado')">
                        Lo cerrado con la agencia: el restaurante elegido de cada servicio y su menú.
                    </div>
                    <div class="alert alert-info mb-2" role="status"
                         invisible="restagrup_stage_key in ('expediente', 'cerrado')">
                        Los restaurantes con presupuesto de cada servicio. Elige uno por servicio (o deja que la agencia
                        elija con el enlace) y pulsa «Crear presupuesto».
                    </div>
                    <field name="restagrup_proposal_line_ids" nolabel="1" readonly="1">
                        <list create="0" delete="0" default_group_by="search_id">
                            <field name="search_id" column_invisible="1"/>
                            <field name="is_chosen" column_invisible="1"/>
                            <field name="name" string="Restaurante" decoration-bf="is_chosen"
                                   decoration-success="is_chosen"/>
                            <field name="menu_id"/>
                            <button name="action_preview_menu" type="object" icon="fa-eye" title="Ver los platos"
                                    class="btn-link" invisible="not menu_id"/>
                            <field name="quote_client_price_per_person" string="Agencia (€/pers.)"/>
                            <field name="quote_price_pp" string="Restaurante (€/pers.)" optional="show"/>
                            <field name="quote_notes" optional="hide"/>
                            <field name="agency_choice_notes" string="Pidió la agencia" optional="show"/>
                            <button name="action_toggle_chosen" type="object" string="Elegir" icon="fa-check"
                                    class="btn-link"
                                    invisible="is_chosen or parent.restagrup_stage_key in ('expediente', 'cerrado')"/>
                            <button name="action_toggle_chosen" type="object" string="Quitar elegido" icon="fa-star"
                                    class="btn-link text-success"
                                    invisible="not is_chosen or parent.restagrup_stage_key in ('expediente', 'cerrado')"/>
                        </list>
                    </field>
                </page>
                <page name="restagrup_conversation" string="Conversación">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge" style="background:#2f6fb3">Agencia</span>
                        <span class="badge" style="background:#c46a12">Restaurante</span>
                        <span class="badge" style="background:#2e8b57">RestaGrup</span>
                        <span class="ms-auto">Ver:</span>
                        <field name="restagrup_conversation_filter" widget="radio" options="{'horizontal': true}"
                               nolabel="1"/>
                    </div>
                    <field name="restagrup_conversation_html" nolabel="1" readonly="1"/>
                </page>
                <page name="restagrup_menus" string="Menús" invisible="not restagrup_candidate_menu_ids">
                    <div class="alert alert-success mb-2" role="status"
                         invisible="restagrup_stage_key not in ('expediente', 'cerrado')">
                        El menú elegido de cada restaurante cerrado con la agencia.
                    </div>
                    <field name="restagrup_candidate_menu_ids" nolabel="1" readonly="1">
                        <list create="0" delete="0" default_group_by="partner_id">
                            <field name="partner_id" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="company_currency_id" column_invisible="1"/>
                            <field name="name"/>
                            <field name="menu_type" optional="show"/>
                            <field name="cost_price" string="Coste (pers., su moneda)"/>
                            <field name="sale_price" string="Venta (€/pers.)"/>
                            <field name="dishes_missing" string="Platos sin completar" optional="show"/>
                            <field name="description" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>


    <!-- Expediente con sus documentos a mano (ronda de ajustes 09/11) -->
    <record id="crm_lead_view_form_file_documents" model="ir.ui.view">
        <field name="name">crm.lead.form.restagrup.file.documents</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_agency_confirmation" type="object" string="Enviar confirmación a la agencia"
                        class="btn-primary" invisible="restagrup_stage_key != 'expediente'"
                        help="Correo a la agencia con la confirmación en PDF: la reserva queda confirmada y se le pide el menú, el contacto del guía y las intolerancias."/>
                <button name="action_send_restaurant_confirmations" type="object"
                        string="Enviar confirmación a restaurantes" class="btn-secondary"
                        invisible="restagrup_stage_key != 'expediente'"/>
                <button name="action_download_agency_confirmation" type="object" string="Conf. agencia"
                        icon="fa-download" class="btn-secondary" invisible="restagrup_stage_key not in ('expediente', 'cerrado')"/>
                <button name="action_download_restaurant_confirmation" type="object" string="Conf. restaurante"
                        icon="fa-download" class="btn-secondary" invisible="restagrup_stage_key not in ('expediente', 'cerrado')"/>
                <button name="action_download_voucher" type="object" string="Bono agencia"
                        icon="fa-download" class="btn-secondary" invisible="restagrup_stage_key not in ('expediente', 'cerrado')"/>
            </xpath>
        </field>
    </record>

</odoo>
