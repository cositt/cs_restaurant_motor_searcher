<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_restaurant_search_form_comparison" model="ir.ui.view">
        <field name="name">restagrup.restaurant.search.form.comparison</field>
        <field name="model">restagrup.restaurant.search</field>
        <field name="inherit_id" ref="restagrup_restaurants.view_restaurant_search_form"/>
        <field name="arch" type="xml">
            <!-- Mostrar u ocultar los restaurantes se decide junto al envío de la comparativa. -->
            <xpath expr="//sheet//field[@name='restaurant_visible']" position="replace"/>
            <!-- Al cliente se le escribe solo desde la petición («Enviar propuesta a la agencia»): el buscador
                 queda para buscar restaurantes y pedirles presupuesto (PPT de Conchita 2026-11-04). -->
        </field>
    </record>
</odoo>
