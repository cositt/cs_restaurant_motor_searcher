<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ronda 20/11 (2b): editar el menú elegido -->
    <record id="view_restagrup_chosen_menu_wizard_form" model="ir.ui.view">
        <field name="name">restagrup.chosen.menu.wizard.form</field>
        <field name="model">restagrup.chosen.menu.wizard</field>
        <field name="arch" type="xml">
            <form string="Editar el menú elegido">
                <div class="alert alert-info" role="status">
                    Marca los platos que ha elegido la agencia (también si cambia de idea o lo confirma por teléfono).
                    Lo que no esté en el menú, escríbelo abajo, uno por línea. Quedará anotado en el historial del grupo.
                </div>
                <div class="alert alert-warning" role="status" invisible="not order_id">
                    Ya hay un pedido: los documentos nuevos saldrán con este menú, pero los que ya enviaste no cambian.
                    Vuelve a enviar la confirmación o el bono si hace falta.
                </div>
                <field name="menu_id" invisible="1"/>
                <field name="order_id" invisible="1"/>
                <field name="line_ids" nolabel="1" invisible="not line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="course" readonly="1"/>
                        <field name="name"/>
                    </list>
                </field>
                <group>
                    <field name="extra_text" placeholder="Ej.: Tarta de la abuela&#10;Sin gluten para 2 personas"/>
                </group>
                <footer>
                    <button name="action_save" type="object" string="Guardar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
